# Copy the backend values to backend/.env. Never put API keys in frontend environment files.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
CORS_ORIGINS=http://localhost:5173
SESSION_REQUEST_LIMIT=20
RETRIEVAL_INDEX_PATH=data/vector_store/legal_index.json
RETRIEVAL_RAW_PATH=data/raw
RETRIEVAL_PROCESSED_PATH=data/processed
RETRIEVAL_MINIMUM_RELEVANCE=0.12
